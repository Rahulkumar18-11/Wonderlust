<% layout("/layouts/boilerplate") %>

<div class="container py-5 my-2">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8">
            <!-- Main Success Card -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white text-center p-4 p-md-5 mb-4">
                <!-- Green Animated Checkmark Icon -->
                <div class="mb-4">
                    <div class="rounded-circle bg-success bg-opacity-10 text-success d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="fa-solid fa-circle-check fs-1"></i>
                    </div>
                </div>

                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 mb-2 d-inline-block mx-auto fw-semibold">
                    Payment Successful &bull; Booking Confirmed
                </span>
                
                <h2 class="fw-bold text-dark mb-1">You're going to <%= listing.location %>!</h2>
                <p class="text-muted small mb-4">
                    We've emailed your confirmed itinerary and receipt to <strong><%= booking.email %></strong>.
                </p>

                <!-- Booking Voucher Box -->
                <div class="card border rounded-4 text-start p-3 p-md-4 mb-4 bg-light shadow-sm">
                    <div class="d-flex flex-wrap justify-content-between align-items-center pb-3 border-bottom mb-3">
                        <div>
                            <span class="text-muted small d-block">Booking Reference Code</span>
                            <span class="fs-5 fw-bold text-dark font-monospace"><%= booking.bookingId %></span>
                        </div>
                        <div class="text-end">
                            <span class="text-muted small d-block">Payment Method</span>
                            <span class="badge bg-white text-dark border px-2 py-1"><i class="fa-solid fa-credit-card text-danger me-1"></i><%= booking.paymentMethod %></span>
                        </div>
                    </div>

                    <!-- Property Summary -->
                    <div class="d-flex gap-3 align-items-center pb-3 border-bottom mb-3">
                        <img src="<%= listing.image.url %>" alt="<%= listing.title %>" class="rounded-3 object-fit-cover shadow-sm" style="width: 80px; height: 75px;">
                        <div>
                            <h6 class="fw-bold mb-1 text-dark"><%= listing.title %></h6>
                            <p class="text-muted small mb-0"><i class="fa-solid fa-location-dot text-danger me-1"></i><%= listing.location %>, <%= listing.country %></p>
                            <span class="small text-secondary">Hosted by <%= listing.owner ? listing.owner.username : "WanderLust Host" %></span>
                        </div>
                    </div>

                    <!-- Key Stay Information -->
                    <div class="row g-3 py-2">
                        <div class="col-6 col-md-3">
                            <span class="text-muted small d-block">Check-in</span>
                            <span class="fw-bold text-dark"><%= booking.checkin %></span>
                            <span class="text-muted d-block" style="font-size: 0.72rem;">After 2:00 PM</span>
                        </div>
                        <div class="col-6 col-md-3">
                            <span class="text-muted small d-block">Checkout</span>
                            <span class="fw-bold text-dark"><%= booking.checkout %></span>
                            <span class="text-muted d-block" style="font-size: 0.72rem;">Before 11:00 AM</span>
                        </div>
                        <div class="col-6 col-md-3">
                            <span class="text-muted small d-block">Guests</span>
                            <span class="fw-bold text-dark"><%= booking.guests %> Guest(s)</span>
                        </div>
                        <div class="col-6 col-md-3">
                            <span class="text-muted small d-block">Amount Paid</span>
                            <span class="fw-bold text-success fs-6">&#8377;<%= Number(booking.totalPrice).toLocaleString("en-IN") %></span>
                        </div>
                    </div>

                    <!-- Smart Lock Access Pass -->
                    <div class="mt-3 p-3 bg-white rounded-3 border d-flex justify-content-between align-items-center">
                        <div>
                            <span class="d-block small fw-bold text-dark"><i class="fa-solid fa-key text-warning me-1"></i>Digital Key & Door Access Code</span>
                            <span class="text-muted small" style="font-size: 0.75rem;">Enter this code on the smart keypad at check-in.</span>
                        </div>
                        <span class="badge bg-dark fs-6 px-3 py-2 font-monospace"><%= booking.accessCode %></span>
                    </div>
                </div>

                <!-- Action Buttons: Print, Directions & Home -->
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <button type="button" class="btn btn-outline-dark rounded-pill px-4 fw-semibold" onclick="window.print()">
                        <i class="fa-solid fa-print me-1"></i> Print / Save Receipt
                    </button>

                    <a href="https://www.google.com/maps/dir/?api=1&destination=<%= encodeURIComponent(listing.location + ', ' + listing.country) %>" 
                        target="_blank" rel="noopener noreferrer" 
                        class="btn btn-outline-danger rounded-pill px-4 fw-semibold">
                        <i class="fa-solid fa-diamond-turn-right me-1"></i> Google Maps Directions
                    </a>

                    <a href="/listings" class="btn btn-airbnb-gradient rounded-pill px-4 text-white fw-semibold">
                        <i class="fa-solid fa-compass me-1"></i> Explore More Stays
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

