<nav class="navbar navbar-expand-md bg-white border-bottom sticky-top shadow-sm py-2">
    <div class="container-fluid px-3 px-md-4">
        <!-- Brand Logo -->
        <a class="navbar-brand d-flex align-items-center me-3" href="/listings">
            <i class="fa-regular fa-compass brand-icon me-2"></i>
            <span id="web-title" class="fw-bold fs-4">WanderLust</span>
        </a>

        <!-- Mobile Toggler -->
        <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-label="Toggle navigation">
            <i class="fa-solid fa-bars fs-5"></i>
        </button>

        <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
            <!-- Center Search Bar -->
            <div class="nav-search mx-auto my-2 my-md-0">
                <form class="d-flex align-items-center search-form-pill" role="search" action="/listings/search" method="get" id="searchBox">
                    <input class="form-control border-0 shadow-none search-inp" type="search"
                        placeholder="Search destinations, villas, beaches..." aria-label="Search" name="q" id="mySearchInput" />
                    <button class="btn search-btn rounded-circle d-flex align-items-center justify-content-center" type="submit" id="search" aria-label="Search">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </form>
            </div>

            <!-- Right Nav Links & User Menu -->
            <div class="navbar-nav align-items-center ms-auto">
                <a class="nav-link host-link fw-semibold px-3 py-2 rounded-pill me-2 d-none d-md-inline" href="/listings/new">
                    Airbnb your home
                </a>

                <!-- User Dropdown Menu -->
                <div class="dropdown">
                    <button class="btn user-menu-pill border bg-white d-flex align-items-center px-3 py-1 rounded-pill shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fa-solid fa-bars text-secondary me-2"></i>
                        <% if (currUser) { %>
                            <div class="user-avatar-circle bg-danger text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 28px; height: 28px; font-size: 0.8rem;">
