<% layout("/layouts/boilerplate") %>

<div class="auth-wrapper py-4 py-md-5">
    <div class="container">
        <!-- Back to Listings Navigation -->
        <div class="row justify-content-center mb-3">
            <div class="col-12 col-xl-10">
                <a href="/listings" class="text-decoration-none text-muted small d-inline-flex align-items-center">
                    <i class="fa-solid fa-arrow-left me-2"></i> Back to Explore
                </a>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-12 col-xl-10">
                <div class="card auth-dual-card border-0">
                    <div class="row g-0">
                        <!-- Left Column: Travel Hero Showcase -->
                        <div class="col-lg-6 d-none d-lg-block position-relative">
                            <div class="auth-hero-banner" style="background-image: url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1200&q=80');">
                                <div class="auth-hero-overlay"></div>
                                <div class="auth-hero-content d-flex flex-column justify-content-between h-100">
                                    <!-- Brand Tag -->
                                    <div>
                                        <div class="d-inline-flex align-items-center gap-2 bg-white bg-opacity-25 px-3 py-1 rounded-pill text-white small fw-semibold mb-4">
                                            <i class="fa-regular fa-compass"></i> WanderLust Travel
                                        </div>
                                        <h2 class="display-6 fw-bold text-white mb-3" style="letter-spacing: -0.5px;">
                                            Join our global travel collective.
                                        </h2>
                                        <p class="text-white-50 mb-4" style="font-size: 0.95rem; line-height: 1.6;">
                                            Create your free account today and unlock exclusive access to private villas, beachfront cabins, and luxury escapes.
                                        </p>

                                        <!-- Trust Badges -->
                                        <div class="d-flex flex-column gap-2 mb-4">
                                            <div class="d-flex align-items-center text-white small">
                                                <i class="fa-solid fa-circle-check text-warning me-2"></i> Access member-only pricing and secret destinations
                                            </div>
                                            <div class="d-flex align-items-center text-white small">
                                                <i class="fa-solid fa-circle-check text-warning me-2"></i> Save favorites and plan group itineraries
                                            </div>
                                            <div class="d-flex align-items-center text-white small">
                                                <i class="fa-solid fa-circle-check text-warning me-2"></i> Instant booking passes and keyless access
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Floating Testimonial Card -->
                                    <div class="auth-glass-card shadow-sm mt-auto">
                                        <div class="d-flex align-items-center text-warning small mb-2">
                                            <i class="fa-solid fa-star"></i>
                                            <i class="fa-solid fa-star"></i>
                                            <i class="fa-solid fa-star"></i>
                                            <i class="fa-solid fa-star"></i>
                                            <i class="fa-solid fa-star"></i>
                                            <span class="text-white ms-2 fw-semibold">4.9 / 5.0</span>
                                        </div>
                                        <p class="small text-white-50 mb-2 fst-italic">
                                            "Signing up took under a minute. The booking confirmations with door codes make traveling completely stress-free!"
                                        </p>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-white text-danger fw-bold rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 28px; height: 28px; font-size: 0.75rem;">
                                                MK
                                            </div>
                                            <span class="small fw-semibold text-white">Marcus Klein · Berlin, Germany</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right Column: Signup Form -->
                        <div class="col-12 col-lg-6">
                            <div class="auth-form-side h-100 d-flex flex-column justify-content-center">
                                <!-- Form Header -->
                                <div class="mb-4">
                                    <div class="auth-icon-badge mb-3">
                                        <i class="fa-solid fa-user-plus"></i>
                                    </div>
                                    <h3 class="fw-bold mb-1" style="color: #0f172a; letter-spacing: -0.5px;">Create an account</h3>
                                    <p class="text-muted small mb-0">Fill in your information to join WanderLust today</p>
                                </div>

                                <!-- Signup Form -->
                                <form action="/signup" method="post" novalidate class="needs-validation" id="signupForm">
                                    <!-- Username -->
                                    <div class="mb-3">
                                        <label for="username" class="form-label small fw-semibold text-secondary">Username</label>
                                        <div class="input-group auth-input-group">
                                            <span class="input-group-text">
                                                <i class="fa-regular fa-user"></i>
                                            </span>
                                            <input type="text" class="form-control" name="username" id="username"
                                                placeholder="Choose a username" required autocomplete="username">
                                            <div class="invalid-feedback">Please choose a username.</div>
                                        </div>
                                    </div>

                                    <!-- Email -->
                                    <div class="mb-3">
                                        <label for="email" class="form-label small fw-semibold text-secondary">Email address</label>
                                        <div class="input-group auth-input-group">
                                            <span class="input-group-text">
                                                <i class="fa-regular fa-envelope"></i>
                                            </span>
                                            <input type="email" class="form-control" name="email" id="email"
                                                placeholder="name@example.com" required autocomplete="email">
                                            <div class="invalid-feedback">Please enter a valid email address.</div>
                                        </div>
                                    </div>

                                    <!-- Password -->
                                    <div class="mb-2">
                                        <label for="password" class="form-label small fw-semibold text-secondary">Password</label>
                                        <div class="input-group auth-input-group">
                                            <span class="input-group-text">
                                                <i class="fa-solid fa-lock"></i>
                                            </span>
                                            <input type="password" class="form-control" name="password" id="password"
                                                placeholder="Create a strong password (min 6 chars)" required minlength="6" autocomplete="new-password">
                                            <button class="btn btn-outline-secondary password-toggle-btn" type="button" id="togglePasswordBtn">
                                                <i class="fa-regular fa-eye" id="togglePasswordIcon"></i>
                                            </button>
                                            <div class="invalid-feedback">Password must be at least 6 characters.</div>
                                        </div>
                                    </div>

                                    <!-- Live Password Strength Meter -->
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="text-muted" style="font-size: 0.72rem;">Strength:</span>
                                            <span id="strengthText" class="fw-semibold" style="font-size: 0.72rem; color: #94a3b8;">Enter password</span>
                                        </div>
                                        <div class="progress" style="height: 4px; background-color: #f1f5f9;">
                                            <div id="strengthBar" class="progress-bar password-strength-bar bg-secondary" role="progressbar" style="width: 0%;"></div>
                                        </div>
                                    </div>

                                    <!-- Terms & Privacy -->
                                    <div class="form-check mb-4">
                                        <input class="form-check-input" type="checkbox" id="agreeTerms" required checked>
                                        <label class="form-check-label small text-muted" for="agreeTerms">
                                            I agree to the <a href="#" class="text-dark fw-semibold text-decoration-none" onclick="alert('WanderLust Terms of Service.'); return false;">Terms of Service</a> & <a href="#" class="text-dark fw-semibold text-decoration-none" onclick="alert('WanderLust Privacy Policy.'); return false;">Privacy Policy</a>.
                                        </label>
                                    </div>

                                    <!-- Submit Button -->
                                    <button type="submit" class="btn btn-airbnb-gradient w-100 py-2p5 fw-bold rounded-3 mb-3 shadow-sm">
                                        <i class="fa-solid fa-user-plus me-2"></i> Create Free Account
                                    </button>

                                    <!-- Social Auth Divider -->
                                    <div class="position-relative text-center my-4">
                                        <hr class="text-muted opacity-25">
                                        <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small">
                                            or continue with
                                        </span>
                                    </div>

                                    <!-- Social Auth Buttons -->
                                    <div class="row g-2 mb-4">
                                        <div class="col-6">
                                            <button type="button" class="btn social-auth-btn w-100" onclick="alert('Google authentication is connected in production.')">
                                                <i class="fa-brands fa-google text-danger me-2"></i> Google
                                            </button>
                                        </div>
                                        <div class="col-6">
                                            <button type="button" class="btn social-auth-btn w-100" onclick="alert('GitHub authentication is connected in production.')">
                                                <i class="fa-brands fa-github me-2"></i> GitHub
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Switch to Login -->
                                    <div class="text-center pt-2 border-top">
                                        <p class="text-muted small mb-0 mt-3">
                                            Already have an account? 
                                            <a href="/login" class="text-danger fw-bold text-decoration-none ms-1">Log in here</a>
                                        </p>
                                    </div>

                                    <!-- Trust & Encryption Badge -->
                                    <div class="text-center mt-3">
                                        <span class="text-muted" style="font-size: 0.75rem;">
                                            <i class="fa-solid fa-shield-halved text-success me-1"></i> Safe & confidential registration
                                        </span>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Password show/hide toggle
    const togglePasswordBtn = document.getElementById('togglePasswordBtn');
    const passwordInput = document.getElementById('password');
    const togglePasswordIcon = document.getElementById('togglePasswordIcon');
    if (togglePasswordBtn) {
        togglePasswordBtn.addEventListener('click', () => {
            const isPassword = passwordInput.getAttribute('type') === 'password';
            passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
            togglePasswordIcon.className = isPassword ? 'fa-regular fa-eye-slash' : 'fa-regular fa-eye';
        });
    }

    // Dynamic password strength meter
    const strengthBar = document.getElementById('strengthBar');
    const strengthText = document.getElementById('strengthText');

    if (passwordInput && strengthBar && strengthText) {
        passwordInput.addEventListener('input', () => {
            const val = passwordInput.value;
            let score = 0;
            if (val.length >= 6) score += 25;
            if (val.length >= 10) score += 25;
            if (/[0-9]/.test(val)) score += 25;
            if (/[^A-Za-z0-9]/.test(val)) score += 25;

            strengthBar.style.width = score + '%';

            if (val.length === 0) {
                strengthBar.className = 'progress-bar password-strength-bar bg-secondary';
                strengthText.textContent = 'Enter password';
                strengthText.style.color = '#94a3b8';
            } else if (score <= 25) {
                strengthBar.className = 'progress-bar password-strength-bar bg-danger';
                strengthText.textContent = 'Weak';
                strengthText.style.color = '#dc2626';
            } else if (score <= 50) {
                strengthBar.className = 'progress-bar password-strength-bar bg-warning';
                strengthText.textContent = 'Fair';
                strengthText.style.color = '#d97706';
            } else if (score <= 75) {
                strengthBar.className = 'progress-bar password-strength-bar bg-info';
                strengthText.textContent = 'Good';
                strengthText.style.color = '#0284c7';
            } else {
                strengthBar.className = 'progress-bar password-strength-bar bg-success';
                strengthText.textContent = 'Strong';
                strengthText.style.color = '#16a34a';
            }
        });
    }
</script>
